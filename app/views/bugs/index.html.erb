<main class="bug-lab">
  <header class="lab-header">
    <div class="header-main">
      <div class="title-row">
        <h1><span class="brand-bug">BUG</span> GENERATOR</h1>

      </div>
      <a href="https://github.com/mize1978/bug_generator" class="github-link" target="_blank" rel="noopener">GitHub ↗</a>
    </div>
    <div class="header-caption"><p>人生、<br><span class="headline-red">バグ</span>ってない？</p><span>バグを笑いに変えるミニアプリ。</span></div>
  </header>

  <turbo-frame id="bug">
    <div class="lab-grid">
      <section class="generator-panel" aria-label="バグを生成">
        <div class="panel-heading"><h2>GENERATE A <span>BUG</span></h2><span class="section-index">01 / GENERATOR</span></div>
        <nav class="category-picker" aria-label="バグのテーマ">
          <% { "all" => "おまかせ" }.merge(BugRoll::CATEGORIES.transform_values(&:first)).each do |key, label| %>
            <%= link_to label, root_path(category: key), class: "category-chip #{'selected' if @selected_category == key}", aria: { current: (@selected_category == key ? "true" : nil) } %>
          <% end %>
        </nav>
        <div class="cube-stage">
          <div class="stage-caption"><span>RANDOM BUG ENGINE</span><span>NO PERFECT HUMANS.</span></div>
          <img src="/images/bug-cube-v2.webp" class="bug-cube" width="1200" height="1255" alt="赤いバグの紋章が光る、浮遊する黒いキューブ" fetchpriority="high">
          <span class="stage-coordinate" aria-hidden="true">[ HUMAN.EXE ]<br>READY TO FAIL BETTER.</span>
        </div>
        <%= button_to root_path, method: :get, params: { category: @selected_category, roll: "1" }, class: "bug-btn", data: { turbo_frame: "bug" } do %>
          <span class="button-arrow" aria-hidden="true">›_</span><span><strong><%= @generated ? "もう一回バグる" : "バグる" %></strong><small>GENERATE RANDOM BUG</small></span><span class="button-plus" aria-hidden="true">＋</span>
        <% end %>
        <p class="generator-footnote">テーマを選んで、今日のバグをひとつ。</p>
      </section>

      <section class="result-panel <%= 'is-rare' if @generated && @result[:rare] %>" style="<%= "--name-len:#{@result[:type].length}" if @generated %>" aria-label="生成結果" aria-live="polite">
        <div class="ladybug-stage" data-controller="ladybug">
          <svg class="ladybug-thread" aria-hidden="true"><path data-ladybug-target="thread" d="M28 0 L28 45" /></svg>
          <button type="button" class="ladybug-handle" aria-label="MizeLyのてんとう虫を揺らす" data-ladybug-target="bug"><%= render "shared/ladybug" %></button>
        </div>
        <div class="panel-heading"><h2>BUG REPORT</h2><span class="report-state"><span class="state-dot"></span><%= @generated ? (@result[:rare] ? "✦ RARE BUG" : "GENERATED") : "STANDBY" %></span></div>
        <% if @generated %>
          <article class="report-card error-box <%= 'rare' if @result[:rare] %>" data-controller="severity-count">
            <div class="report-context"><span class="bug-category"><%= @result[:category] %></span><span>HUMAN / EXCEPTION</span></div>
            <div class="severity-heading"><span>SEVERITY</span><span><strong data-severity-count-target="value" data-to="<%= @result[:severity] %>"><%= @result[:severity] %></strong>%</span></div>
            <div class="severity-track"><span style="width:<%= @result[:severity] %>%"></span></div>
            <div class="error-detail"><p class="field-label">ERROR NAME</p><h3 class="error-name" aria-label="<%= @result[:type] %>"><%= typed_error_name(@result[:type]) %></h3><p class="bug-message"><%= @result[:message] %></p></div>
            <div class="trace-block"><p class="field-label">STACK TRACE</p><pre class="stack-trace"><% @result[:trace].each_with_index do |line, i| %><span class="trace-line" style="--i:<%= i %>"><%= line %></span><% end %></pre></div>
          </article>
          <aside class="hint-panel"><h3><span aria-hidden="true">✧</span> WORKAROUND</h3><p><%= @result[:hint] %></p></aside>
          <div class="report-actions" data-controller="copy" data-copy-text-value="<%= @result[:text] %>">
            <button type="button" class="copy-btn" data-copy-target="btn" data-action="copy#copy">▢ コピー</button>
            <a href="https://twitter.com/intent/tweet?text=<%= ERB::Util.url_encode(@share_text) %>&url=<%= ERB::Util.url_encode(@share_url) %>" target="_blank" rel="noopener" class="share-btn">𝕏 に投稿 ↗</a>
          </div>
        <% else %>
          <div class="report-card standby-card">
            <div class="report-context"><span class="bug-category">READY</span><span>HUMAN / EXCEPTION</span></div>
            <div class="standby-body"><span class="standby-symbol" aria-hidden="true">[ _ ]</span><h3>まだ、バグっていません。</h3><p>テーマを選んで「バグる」を押すと、<br>あなたの架空エラーログが生成されます。</p><code>&gt; waiting for your first bug<span class="terminal-cursor">_</span></code></div>
          </div>
          <aside class="hint-panel hint-standby"><h3><span aria-hidden="true">✧</span> WORKAROUND</h3><p>寝るか、コーヒーか。対処法は生成後に。</p></aside>
          <div class="report-actions"><button type="button" class="copy-btn" disabled>▢ コピー</button><button type="button" class="share-btn" disabled>𝕏 に投稿 ↗</button></div>
        <% end %>
      </section>
    </div>
  </turbo-frame>
  <footer class="lab-footer"><span>架空のエラーログで遊ぶミニアプリ。</span><span class="footer-motto">EMBRACE <b>THE BUGS.</b></span></footer>
</main>
